{
  "name": "human-in-the-loop",
  "version": "1.0.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:fast": "vitest run --exclude tests/sim/balance.test.js",
    "test:balance": "vitest run tests/sim/balance.test.js",
    "ci": "bash scripts/ci-local.sh",
    "gates": "bash scripts/gates.sh",
    "feature-media": "node scripts/feature-media/render.mjs",
    "balance": "node scripts/balance.js",
    "snap": "node scripts/snap.js",
    "pace": "node scripts/pace.js",
    "lifecycle": "node scripts/lifecycle.js",
    "soak": "node scripts/soak.js",
    "capture": "node scripts/capture.js",
    "trailer": "node scripts/trailer/build.js",
    "models": "bash scripts/build-models.sh",
    "hooks": "git config core.hooksPath scripts/hooks"
  },
  "type": "module",
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "playwright": "^1.63.0",
    "semantic-release": "25.0.9",
    "three-mesh-bvh": "0.9.15",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "private": true
}
