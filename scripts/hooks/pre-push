#!/usr/bin/env bash
# Refuses to push to a branch whose pull request is already merged or closed: those commits would
# never reach feat/one-shot. Put them on a new branch and open a new PR instead.
# Installed by `npm run hooks` (core.hooksPath scripts/hooks: each worktree runs its own copy).
# Skip once with `git push --no-verify`.
set -u
command -v gh >/dev/null 2>&1 || { echo "pre-push: gh not found; merged-PR check skipped" >&2; exit 0; }
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  [ "$local_sha" = 0000000000000000000000000000000000000000 ] && continue   # branch deletion
  branch="${remote_ref#refs/heads/}"
  states="$(gh pr list --head "$branch" --state all --json number,state --jq '.[] | "\(.number) \(.state)"' 2>/dev/null)" \
    || { echo "pre-push: could not ask GitHub about $branch; merged-PR check skipped" >&2; continue; }
  [ -z "$states" ] && continue                                   # no PR yet
  echo "$states" | grep -q " OPEN$" && continue                   # an open PR still takes pushes
  done_pr="$(echo "$states" | head -1)"
  echo "pre-push: refusing to push $branch: PR #${done_pr% *} is ${done_pr#* } (no open PR uses this branch)." >&2
  echo "pre-push: new commits here would never merge. Start a new branch from origin/feat/one-shot, cherry-pick them, and open a new PR." >&2
  status=1
done
exit $status
